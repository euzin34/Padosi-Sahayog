# Server Configuration
PORT=5000

# Firebase Configuration
# Path to your Firebase service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional: Firebase project configuration (if not using service account file)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email
# FIREBASE_PRIVATE_KEY=your-private-key

# Geocoding API Configuration
# Using OpenStreetMap Nominatim (free, rate-limited)
GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=PadosiSahayog/1.0

# Optional: Use Geoapify for better rate limits (requires API key)
# GEOAPIFY_API_KEY=your-api-key
# GEOCODING_API_URL=https://api.geoapify.com/v1/geocode/reverse
